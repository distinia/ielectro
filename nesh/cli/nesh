<?php
require __DIR__ . '/../src/autoload.php';
global $argv;
$command = strtolower($argv[1] ?? '');
$allowed = ['install', 'db', 'deploy', 'help'];
if ($command === '' || !in_array($command, $allowed, true)) {
    echo 'Usage: php nesh <command> [arguments]' . PHP_EOL;
    echo PHP_EOL;
    echo 'Commands: ' . implode(', ', $allowed) . PHP_EOL;
    echo PHP_EOL;
    echo 'Run "php nesh help" for details.' . PHP_EOL;
    exit($command === '' ? 1 : 1);
}
$file = NESH_CLI . '/' . $command . '.php';
if (!is_file($file)) {
    echo 'Unknown command: ' . $command . PHP_EOL;
    exit(1);
}
require $file;
